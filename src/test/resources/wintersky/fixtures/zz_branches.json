{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "wintersky:branches_fixture",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/particles"
      }
    },
    "curves": {
      "variable.size_curve": {
        "type": "catmull_rom",
        "nodes": [0, 1, 0.5, 1],
        "input": "v.particle_age",
        "horizontal_range": "v.particle_lifetime"
      },
      "variable.alpha_curve": {
        "type": "bezier_chain",
        "nodes": {
          "0.0": {"value": 0, "slope": 0},
          "0.5": {"value": 1, "slope": 2},
          "1.0": {"value": 0, "slope": 0}
        },
        "input": "v.particle_age",
        "horizontal_range": "v.particle_lifetime"
      }
    },
    "events": {
      "spawn_smoke": {
        "particle_effect": {
          "effect": "minecraft:basic_smoke_particle",
          "type": "emitter_bound"
        }
      },
      "spawn_combo": {
        "sequence": [
          {"particle_effect": {"effect": "minecraft:basic_flame_particle", "type": "particle"}},
          {"expression": "v.combo_count = v.combo_count + 1;"}
        ]
      },
      "spawn_random": {
        "randomize": [
          {"weight": 1, "particle_effect": {"effect": "minecraft:basic_smoke_particle", "type": "particle"}},
          {"weight": 3, "expression": "v.picked_heavy = 1;"}
        ]
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.emitter_seed = math.random(1, 10);",
        "per_update_expression": "v.combo_count = 0;"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1.0
      },
      "minecraft:emitter_lifetime_events": {
        "creation_event": ["spawn_smoke", "spawn_combo"],
        "expiration_event": "spawn_random"
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 10,
        "max_particles": 40
      },
      "minecraft:emitter_shape_box": {
        "offset": [0, 0.5, 0],
        "half_dimensions": [0.5, 0.25, 0.5],
        "surface_only": true,
        "direction": "inwards"
      },
      "minecraft:particle_initialization": {
        "per_update_expression": "v.picked_heavy = 0;"
      },
      "minecraft:particle_lifetime_events": {
        "creation_event": "spawn_smoke",
        "expiration_event": ["spawn_random"]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 1.0
      },
      "minecraft:particle_initial_speed": 2,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, -1, 0],
        "linear_drag_coefficient": 0.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": ["variable.size_curve", 0.25],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [0, 0],
          "uv_size": [8, 8]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": "#ff8000c0"
      }
    }
  }
}
