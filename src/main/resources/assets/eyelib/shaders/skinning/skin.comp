#version 430

// C1 GPU 蒙皮 compute 路径（≤26.1，GL≥4.6 探测启用，ADR-0032）：
// 静态绑定姿态几何（in）× 骨骼调色板（palette）→ 蒙皮后顶点（out），
// 输出缓冲随后作为 GL_ARRAY_BUFFER 由 entity_skinned_compute* 直通管线绘制。
// 蒙皮数学与 CPU 路径 BakedBone.transformPos/transformNormal 逐行同构
// （法线归一化守卫在 VS 侧完成，与 VS 蒙皮路径一致）。

layout(local_size_x = 64) in;

// std430：vec3/vec2 按 16B 对齐填充，Java 侧打包 12 float = 48B 顶点步长
struct VertIn {
    vec4 posSlot;   // xyz = 绑定姿态位置；w = intBitsToFloat(palette slot)
    vec4 nrm;       // xyz = 绑定姿态法线（字节量化精度，与 VS 路径上传一致）
    vec2 uv;
    vec2 pad0;
};

struct VertOut {
    vec4 pos;       // xyz = 蒙皮后模型空间位置
    vec4 nrm;       // xyz = 蒙皮后法线（未归一化，VS 侧 lenSq 守卫归一化）
    vec2 uv;
    vec2 pad0;
};

layout(std430, binding = 0) readonly buffer InBuf {
    VertIn verts[];
};

layout(std430, binding = 1) writeonly buffer OutBuf {
    VertOut outVerts[];
};

// 与 Java 侧 SkinningLayout.MAX_BONES 保持一致（96×64B×2 = 12KB SSBO）
layout(std430, binding = 2) readonly buffer Palette {
    mat4 BonePose[96];
    mat4 BoneNormal[96];
};

uniform int VertexCount;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(VertexCount)) {
        return;
    }
    VertIn v = verts[i];
    uint slot = floatBitsToUint(v.posSlot.w);
    vec4 skinned = BonePose[slot] * vec4(v.posSlot.xyz, 1.0);
    outVerts[i].pos = vec4(skinned.xyz, 1.0);
    outVerts[i].nrm = vec4(mat3(BoneNormal[slot]) * v.nrm.xyz, 0.0);
    outVerts[i].uv = v.uv;
}
