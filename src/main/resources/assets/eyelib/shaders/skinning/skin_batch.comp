#version 430

// C1 跨实体合批 compute 蒙皮（≤26.1，GL≥4.6，ADR-0032）：单进程多实体蒙皮。
// 2D dispatch：x = 子批内顶点序号，y = 子批内实体序号（EntityBase uniform 定位 meta）。
// 每实体 meta 携带紧凑调色板基址/输出顶点基址/tint/light/overlay，
// 输出顶点附带逐实体属性（tint/light/overlay），供 entity_skinned_batch* 直通管线一次合批绘制。
// 蒙皮数学与 CPU 路径 BakedBone.transformPos/transformNormal 逐行同构
// （法线归一化守卫在 VS 侧完成，与 VS 蒙皮路径一致）。

layout(local_size_x = 64) in;

// std430：vec3/vec2 按 16B 对齐填充，Java 侧打包 12 float = 48B 顶点步长
struct VertIn {
    vec4 posSlot;   // xyz = 绑定姿态位置；w = intBitsToFloat(palette slot)
    vec4 nrm;       // xyz = 绑定姿态法线（字节量化精度，与 VS 路径上传一致）
    vec2 uv;
    vec2 pad0;
};

struct VertOut {
    vec4 pos;       // xyz = 蒙皮后模型空间位置
    vec4 nrm;       // xyz = 蒙皮后法线（未归一化，VS 侧 lenSq 守卫归一化）
    vec2 uv;
    vec2 light;     // 逐实体 LightUV（浮点承载整数坐标，VS 侧 ivec2 还原）
    vec2 overlay;   // 逐实体 OverlayUV
    vec2 pad0;
    vec4 tint;      // 逐实体 TintColor（raw float，量化在 VS 侧，与现路径一致）
};

// 与 Java 侧 BatchSkinningProgram.META_STRIDE(64B) 逐字段对应
struct Meta {
    vec4 tint;
    vec4 lightOverlay;  // xy = LightUV，zw = OverlayUV
    uint poseBase;      // mats 中本实体 pose 矩阵起始下标
    uint normalBase;    // mats 中本实体 normal 矩阵起始下标
    uint vertexBase;    // outVerts 中本实体起始下标
    uint pad0;
    uint pad1;
    uint pad2;
};

layout(std430, binding = 0) readonly buffer InBuf {
    VertIn verts[];
};

layout(std430, binding = 1) writeonly buffer OutBuf {
    VertOut outVerts[];
};

// 全部实体调色板紧凑拼接（pose n 个 + normal n 个/实体），与 Java 侧 SkinningLayout.MAX_BONES 上限一致
layout(std430, binding = 2) readonly buffer Palette {
    mat4 mats[];
};

layout(std430, binding = 3) readonly buffer MetaBuf {
    Meta metas[];
};

uniform int VertexCount;
uniform int EntityBase;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(VertexCount)) {
        return;
    }
    Meta m = metas[uint(EntityBase) + gl_GlobalInvocationID.y];
    VertIn v = verts[i];
    uint slot = floatBitsToUint(v.posSlot.w);
    vec4 skinned = mats[m.poseBase + slot] * vec4(v.posSlot.xyz, 1.0);
    uint o = m.vertexBase + i;
    outVerts[o].pos = vec4(skinned.xyz, 1.0);
    outVerts[o].nrm = vec4(mat3(mats[m.normalBase + slot]) * v.nrm.xyz, 0.0);
    outVerts[o].uv = v.uv;
    outVerts[o].light = m.lightOverlay.xy;
    outVerts[o].overlay = m.lightOverlay.zw;
    outVerts[o].tint = m.tint;
}
